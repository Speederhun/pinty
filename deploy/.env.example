# A (al)domain, ami a droplet IP-jére mutat, pl. vault.sajatdomain.hu
PINTY_DOMAIN=vault.example.com
# Az első felhasználó mindig regisztrálhat. Több fiókhoz állítsd true-ra (utána vedd vissza).
PINTY_ALLOW_REGISTRATION=false
# Opcionális kulcs az ELSŐ fiókhoz (openssl rand -hex 16). A többi fiókhoz meghívókód kell:
#   pinty-server invite <e-mail>
PINTY_SETUP_TOKEN=
